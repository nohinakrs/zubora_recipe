  <div class="row">
    <div class="col-md-3">
    <%= render 'list', user: @user%>
    
    </div>

    <div class="col-md-8 offset-md-1">
      <h3><%= @recipe.recipe_name %></h3>
      <%= render "static_rate", recipe: @recipe %>
      <div class="row">
        <div class="col-md-6">
          <%= image_tag @recipe.get_image(300, 300), style: "width:100%;" %>
        </div>
        <div class="col-md-6">
          <table class="table">
            <thead>
              <tr>
                <th width="50%">材料</th>
                <th width="30%">分量</th>
                <th width="20%"></th>
              </tr>
            </thead>
            <tbody>
              <% @recipe.gml_recipes.each do |gml| %>
                <tr>
                  <td><%= gml.material %></td>
                  <td>
                    <%#= gml.number %>
                    <%= text_field_tag "gml_#{gml.id}", "", id: "gml_#{gml.id}", class: "gml-recipes", value: gml.number %>
                  </td>
                  <td><%= gml.unit %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <%= @recipe.recipe %>
      <br>
      <% if @recipe.user == current_user %>
      <%= link_to "Edit", edit_recipe_path(@recipe), class:"btn btn-sm btn-success edit_book_3372" %>
      <%= link_to "Destroy", recipe_path(@recipe), method: :delete, class:"btn btn-sm btn-danger destroy_book_3372", data: { confirm: "本当に消しますか?" } %>
      <% end %>
      <br>
      コメント数: <%= @recipe.comments.count %>
      <% if @recipe.user != current_user %>
        <%= form_with model: [@recipe, RecipeRate.new] do |f| %>
          <div class="form-group" id="star">
            <%= f.label :rate %>
            <%= f.hidden_field :rate, id: :review_star, class: 'form-control' %>
            <div id="post_raty"></div>
          </div>
          <script>
            $(document).on('turbolinks:load', function() {
              let elem = document.querySelector('#post_raty');
              if (elem == null) return;
        
              elem.innerHTML = ""
              let opt = {  
                starOn: "<%= asset_path('star-on.png') %>",
                starOff: "<%= asset_path('star-off.png') %>",
                starHalf: "<%= asset_path('star-half.png') %>",
                scoreName: 'recipe_rate[rate]',
              };
              raty(elem, opt);
            });
          </script>
          <div class="form-group">
            <%= f.submit '評価する',class:"btn btn-success"%>
          </div>
        <% end %>
      <% end %>
      <%= render "comments/index", recipe: @recipe %>
      <%= render "comments/form", recipe: @recipe, comment: @comment %>
    </div>
  </div>


